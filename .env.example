# 실제 키를 넣은 사본은 .env 로 저장한다(.env 는 git에 올라가지 않음).
#   cp .env.example .env
# 이 파일에는 절대 실제 키를 적지 않는다(git에 커밋되는 파일).

# 생성/판정 LLM (설계 B: LLM/Generator·Judge 동일 모델 사용)
OPENAI_API_KEY=

# config.py의 MODEL_ID와 다른 값을 넣으면 실행이 거부된다(모델 임의 대체 금지).
OPENAI_MODEL=gpt-5.6-terra

# 시장·이해관계자 평가 에이전트의 웹 검색 (설계 B-2: Tavily Web API)
TAVILY_API_KEY=

# 선택: 기본 경로를 바꿀 때만 지정
# MANIFEST_PATH=data/manifest.json
# PROCESSED_DIR=data/processed
# OUTPUT_DIR=outputs
