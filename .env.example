# 실제 키를 넣은 사본은 .env 로 저장한다(.env 는 git에 올라가지 않음).
#   cp .env.example .env
# 이 파일에는 절대 실제 키를 적지 않는다(git에 커밋되는 파일).

# 생성/판정 LLM (설계 B: LLM/Generator·Judge 동일 모델 사용)
OPENAI_API_KEY=

# config.py의 MODEL_ID와 다른 값을 넣으면 실행이 거부된다(모델 임의 대체 금지).
OPENAI_MODEL=gpt-5.6-terra

# 웹 검색: 필수(시장·이해관계자·TRL 상용화 근거). 대체 검색 엔진은 없다. 응답은 data/cache/tavily/에 캐시된다.
TAVILY_API_KEY=

# LangSmith 트레이싱: 실행마다 run_name=kv-eval-supervisor, tags=[pattern:supervisor],
# metadata.trace_id(= LangGraph thread_id = outputs/decisions_{trace_id}.jsonl)로 기록된다.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kv-cache-supervisor
# 선택: EU 리전 등 다른 엔드포인트를 쓸 때만
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 선택: Supervisor 안전장치(기본 20). 넘으면 조사를 멈추고 근거 공백을 명시한 보고서로 종료한다.
# MAX_STEPS=20

# 선택: 기본 경로를 바꿀 때만 지정
# MANIFEST_PATH=data/manifest.json
# PROCESSED_DIR=data/processed
# OUTPUT_DIR=outputs
# CHECKPOINT_PATH=outputs/checkpoints.sqlite
# RAG_CACHE_DIR=data/cache
